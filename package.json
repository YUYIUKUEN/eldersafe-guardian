{
  "name": "eldersafe-guardian",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @eldersafe/elder --filter @eldersafe/volunteer --filter @eldersafe/admin run dev",
    "dev:elder": "pnpm --filter @eldersafe/elder run dev",
    "dev:volunteer": "pnpm --filter @eldersafe/volunteer run dev",
    "dev:admin": "pnpm --filter @eldersafe/admin run dev",
    "build": "pnpm --filter @eldersafe/elder --filter @eldersafe/volunteer --filter @eldersafe/admin run build",
    "build:elder": "pnpm --filter @eldersafe/elder run build",
    "build:volunteer": "pnpm --filter @eldersafe/volunteer run build",
    "build:admin": "pnpm --filter @eldersafe/admin run build",
    "lint": "pnpm --filter @eldersafe/elder --filter @eldersafe/volunteer --filter @eldersafe/admin run lint"
  },
  "engines": {
    "node": ">=20"
  }
}
