{
  "name": "eldersafe-guardian",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:elder": "pnpm --filter @eldersafe/elder run dev",
    "dev:volunteer": "pnpm --filter @eldersafe/volunteer run dev",
    "dev:admin": "pnpm --filter @eldersafe/admin run dev",
    "build": "pnpm --filter @eldersafe/elder --filter @eldersafe/volunteer --filter @eldersafe/admin run build",
    "build:elder": "pnpm --filter @eldersafe/elder run build",
    "build:volunteer": "pnpm --filter @eldersafe/volunteer run build",
    "build:admin": "pnpm --filter @eldersafe/admin run build",
    "lint": "pnpm --filter @eldersafe/elder --filter @eldersafe/volunteer --filter @eldersafe/admin run lint",
    "seed:admin-demo": "node --env-file=apps/admin/.env.local ./scripts/seed-admin-demo.mjs",
    "acceptance:admin-4.9": "node --env-file-if-exists=apps/admin/.env.local ./scripts/acceptance-admin-4.9.mjs",
    "acceptance:security-012": "node --env-file-if-exists=apps/admin/.env.local ./scripts/acceptance-security-012.mjs",
    "acceptance:points-certificates": "node --env-file-if-exists=apps/admin/.env.local ./scripts/acceptance-points-certificates.mjs",
    "apply:supabase-migrations": "node --env-file-if-exists=apps/admin/.env.local ./scripts/apply-supabase-migrations.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
