# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Emergency dial safety (default is test mode). Only TEST_MODE=false dials 999.
TEST_MODE=true
# Test mode emergency dial number (must NOT be 999)
TEST_EMERGENCY_NUMBER=+85290000000
