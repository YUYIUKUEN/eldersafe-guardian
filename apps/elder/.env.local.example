# Copy to .env.local — never commit real keys.

# --- Supabase (Stage 5) ---
# Leave placeholders to keep using local .data/store.json fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Elder emergency dialling (test mode MUST NOT use 999)
NEXT_PUBLIC_EMERGENCY_TEST_MODE=true
NEXT_PUBLIC_EMERGENCY_TEST_PHONE=12345678
