# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: elder web app origin used to build police /track links in admin
NEXT_PUBLIC_ELDER_APP_URL=http://localhost:3001

# Optional: organisation name printed on Top 3 volunteer certificates
CERTIFICATE_ORG_NAME=ElderSafe Guardian
